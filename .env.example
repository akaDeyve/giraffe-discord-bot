# Discord Bot Token (vom Discord Developer Portal)
TOKEN=dein_discord_bot_token_hier

# Mistral API-Key (von https://console.mistral.ai)
MISTRAL_API_KEY=dein_api_key_hier

# Base-URL des AI-Providers (Mistral, OpenAI-kompatibel)
BASE_URL=https://api.mistral.ai/v1

# AI-Modell (Mistral Large 4). Achtung: alte -latest-Aliase wie mistral-large-latest sind bei Mistral retired und liefern 400-Fehler.
AI_MODEL=mistral-large-4-0

# Reasoning-Aufwand: none (schnell, ohne Thinking) oder high (mit Thinking-Chunks)
AI_REASONING_EFFORT=none

# Modell des Bild-Agenten fuer /image
IMAGE_MODEL=mistral-medium-3-5

# Modell des Websearch-Agenten fuer /websearch
WEBSEARCH_MODEL=mistral-medium-3-5

# System-Prompt für den AI-Assistenten
AI_SYSTEM_PROMPT=Du bist ein Discord-Assistent, der kurze und prägnante Antworten gibt.

# Kosten pro Million Input-Tokens (in USD)
PRICE_PER_MIO_INPUT_TOKENS=0.68

# Kosten pro Million Output-Tokens (in USD)
PRICE_PER_MIO_OUTPUT_TOKENS=2.09

#Name des Providers
PROVIDER=Mistral AI

#Provider Privacy Policy
PROVIDER_PRIVACY=https://mistral.ai/privacy-policy

# Dashboard: Port und Bindung (127.0.0.1 = nur lokal erreichbar)
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1

# Dashboard-Token (leer lassen = kein Schutz; setzen = Bearer-Token erforderlich)
DASHBOARD_TOKEN=

# Rollen-ID, die der Bot am Geburtstag vergibt (leer = keine Rolle)
BIRTHDAY_ROLE_ID=

# Rollen-ID, die jeder frisch beigetretene Member automatisch bekommt (leer = keine Rolle)
AUTO_ROLE_ID=
